# Environment for deploying with docker-compose.yml.
# Copy this file to `.env` on the deploy host (or keep it as `.env.docker`
# and run `docker compose --env-file .env.docker up -d --build`).

# --- App ---
# Public URL under which the app is reachable (used for OAuth callbacks)
AUTH_URL="https://slr.example.com"
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- Keycloak (hosted separately) ---
KEYCLOAK_ID=""
KEYCLOAK_SECRET=""
# e.g. https://auth.example.com/realms/my-realm
KEYCLOAK_ISSUER=""

# --- Field encryption ---
# Encrypts provider API keys at rest (fields marked /// @encrypted).
# Generate with: npx cloak generate
# WARNING: losing this key makes the stored API keys unreadable.
PRISMA_FIELD_ENCRYPTION_KEY=""

# --- PostgreSQL (container, provisioned by compose) ---
# NOTE: the password is interpolated into a connection URL — use only
# URL-safe characters (letters, digits, - _ ~ .)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=""
POSTGRES_DB=slr-toolkit

# --- Qdrant (container, provisioned by compose) ---
# API key the app uses to talk to Qdrant; also enforced by the Qdrant server
QDRANT_API_KEY=""

# --- Embedding service (hosted separately) ---
# Endpoint returning embeddings (OpenAI-compatible or { embedding: [...] } / plain array)
DEFAULT_VECTORPROVIDER_URL=""
DEFAULT_VECTORPROVIDER_SECRET=""
# Dimensionality of the embeddings, e.g. 1024
DEFAULT_VECTORPROVIDER_VECTOR_SIZE=1024

# --- Classifier service (hosted separately) ---
# Endpoint accepting POST { train, classify } with basic auth
DEFAULT_CLASSIFIER_URL=""
DEFAULT_CLASSIFIER_USERNAME=""
DEFAULT_CLASSIFIER_PASSWORD=""
